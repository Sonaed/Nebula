from __future__ import annotations

from dataclasses import dataclass

from PySide6.QtCore import Qt
from PySide6.QtGui import QImage
from PySide6.QtOpenGL import (
    QOpenGLBuffer,
    QOpenGLShader,
    QOpenGLShaderProgram,
    QOpenGLTexture,
    QOpenGLVertexArrayObject,
)


@dataclass
class GPUTexture:
    texture: QOpenGLTexture
    cache_key: int
    width: int
    height: int


class CanvasGPURenderer:
    """
    Renderer OpenGL minimal pour CreativeSystem.

    Le document reste stocké dans les QImage des Layers.
    Le GPU s'occupe du scaling / pan / transformation du viewport.
    """

    VERTEX_SHADER = """
        attribute highp vec2 a_position;
        attribute mediump vec2 a_texcoord;

        uniform mediump vec2 u_view_size;
        uniform mediump vec2 u_document_size;
        uniform mediump vec2 u_offset;
        uniform mediump float u_zoom;

        uniform mediump vec2 u_transform_center;
        uniform mediump vec2 u_transform_scale;

        varying mediump vec2 v_texcoord;

        void main()
        {
            vec2 document_position =
                a_position * u_document_size;

            document_position =
                u_transform_center
                + (
                    document_position
                    - u_transform_center
                )
                * u_transform_scale;

            vec2 screen_position =
                u_offset
                + document_position * u_zoom;

            float ndc_x =
                (
                    screen_position.x
                    / u_view_size.x
                ) * 2.0 - 1.0;

            float ndc_y =
                1.0
                - (
                    screen_position.y
                    / u_view_size.y
                ) * 2.0;

            gl_Position =
                vec4(
                    ndc_x,
                    ndc_y,
                    0.0,
                    1.0
                );

            v_texcoord = a_texcoord;
        }
    """

    FRAGMENT_SHADER = """
        uniform sampler2D u_texture;
        uniform mediump float u_opacity;

        varying mediump vec2 v_texcoord;

        void main()
        {
            vec4 color =
                texture2D(
                    u_texture,
                    v_texcoord
                );

            color.a *= u_opacity;

            gl_FragColor = color;
        }
    """

    def __init__(self) -> None:

        self.initialized = False

        self.program: QOpenGLShaderProgram | None = None

        self.vbo: QOpenGLBuffer | None = None

        self.vao: QOpenGLVertexArrayObject | None = None

        self.textures: dict[int, GPUTexture] = {}

    # ----------------------------------------------------------
    # INITIALISATION
    # ----------------------------------------------------------

    def initialize(self) -> bool:

        self.program = QOpenGLShaderProgram()

        if not self.program.addShaderFromSourceCode(
            QOpenGLShader.ShaderTypeBit.Vertex,
            self.VERTEX_SHADER,
        ):
            print("GPU Vertex Shader ERROR:")
            print(self.program.log())
            self.program = None
            return False

        if not self.program.addShaderFromSourceCode(
            QOpenGLShader.ShaderTypeBit.Fragment,
            self.FRAGMENT_SHADER,
        ):
            print("GPU Fragment Shader ERROR:")
            print(self.program.log())
            self.program = None
            return False

        if not self.program.link():
            print("GPU Shader Link ERROR:")
            print(self.program.log())
            self.program = None
            return False

        # ------------------------------------------------------
        # Quad unité
        #
        # position X,Y
        # texture U,V
        # ------------------------------------------------------

        vertices = bytes.fromhex(
            """
            00000000 00000000 00000000 00003f80
            0000803f 00000000 0000803f 00003f80
            00000000 0000803f 00000000 00000000
            0000803f 0000803f 0000803f 00000000
            """
        )

        self.vbo = QOpenGLBuffer(
            QOpenGLBuffer.Type.VertexBuffer
        )

        if not self.vbo.create():
            print("GPU ERROR: impossible de créer le VBO.")
            self.vbo = None
            return False

        self.vbo.bind()

        self.vbo.setUsagePattern(
            QOpenGLBuffer.UsagePattern.StaticDraw
        )

        self.vbo.allocate(
            vertices,
            len(vertices),
        )

        self.vao = QOpenGLVertexArrayObject()

        if not self.vao.create():
            print("GPU ERROR: impossible de créer le VAO.")
            self.vbo.release()
            self.vbo.destroy()
            self.vbo = None
            self.vao = None
            return False

        self.vao.bind()

        self.program.bind()

        position_location = (
            self.program.attributeLocation(
                "a_position"
            )
        )

        texcoord_location = (
            self.program.attributeLocation(
                "a_texcoord"
            )
        )

        # GL_FLOAT = 0x1406
        self.program.enableAttributeArray(
            position_location
        )

        self.program.setAttributeBuffer(
            position_location,
            0x1406,
            0,
            2,
            16,
        )

        self.program.enableAttributeArray(
            texcoord_location
        )

        self.program.setAttributeBuffer(
            texcoord_location,
            0x1406,
            8,
            2,
            16,
        )

        self.program.release()

        self.vao.release()
        self.vbo.release()

        self.initialized = True

        print("✓ GPU renderer OpenGL initialisé")

        return True

    # ----------------------------------------------------------
    # TEXTURES
    # ----------------------------------------------------------

    def sync_layer(
        self,
        layer,
    ) -> GPUTexture | None:

        if not self.initialized:
            return None

        key = id(layer)

        cache_key = layer.image.cacheKey()

        existing = self.textures.get(
            key
        )

        if (
            existing is not None
            and existing.cache_key == cache_key
            and existing.width == layer.image.width()
            and existing.height == layer.image.height()
        ):
            return existing

        # ------------------------------------------------------
        # Texture précédente
        # ------------------------------------------------------

        if existing is not None:

            try:
                existing.texture.destroy()
            except RuntimeError:
                pass

            del self.textures[key]

        # ------------------------------------------------------
        # Upload propre
        #
        # Qt indique qu'un QImage est converti en
        # RGBA8888 pour QOpenGLTexture.
        #
        # On flippe verticalement pour correspondre
        # aux coordonnées OpenGL.
        # ------------------------------------------------------

        image = layer.image.flipped(
            Qt.Orientation.Vertical
        )

        texture = QOpenGLTexture(
            image,
            QOpenGLTexture.MipMapGeneration.DontGenerateMipMaps,
        )

        texture.setMinificationFilter(
            QOpenGLTexture.Filter.Linear
        )

        texture.setMagnificationFilter(
            QOpenGLTexture.Filter.Linear
        )

        texture.setWrapMode(
            QOpenGLTexture.CoordinateDirection.DirectionS,
            QOpenGLTexture.WrapMode.ClampToEdge,
        )

        texture.setWrapMode(
            QOpenGLTexture.CoordinateDirection.DirectionT,
            QOpenGLTexture.WrapMode.ClampToEdge,
        )

        result = GPUTexture(
            texture=texture,
            cache_key=cache_key,
            width=layer.image.width(),
            height=layer.image.height(),
        )

        self.textures[key] = result

        return result

    # ----------------------------------------------------------
    # RENDU D'UNE COUCHE
    # ----------------------------------------------------------

    def draw_layer(
        self,
        layer,
        document,
        view_width: float,
        view_height: float,
        zoom: float,
        offset,
        transform_scale_x: float = 1.0,
        transform_scale_y: float = 1.0,
        is_transforming: bool = False,
    ) -> None:

        if not self.initialized:
            return

        if self.program is None:
            return

        if self.vbo is None:
            return

        if self.vao is None:
            return

        gpu_texture = self.sync_layer(
            layer
        )

        if gpu_texture is None:
            return

        self.program.bind()

        self.vao.bind()
        self.vbo.bind()

        self.program.setUniformValue(
            "u_view_size",
            float(view_width),
            float(view_height),
        )

        self.program.setUniformValue(
            "u_document_size",
            float(document.width),
            float(document.height),
        )

        self.program.setUniformValue(
            "u_offset",
            float(offset.x()),
            float(offset.y()),
        )

        self.program.setUniformValue1f(
            "u_zoom",
            float(zoom),
        )

        center_x = (
            float(document.width)
            * 0.5
        )

        center_y = (
            float(document.height)
            * 0.5
        )

        if is_transforming:

            scale_x = float(
                transform_scale_x
            )

            scale_y = float(
                transform_scale_y
            )

        else:

            scale_x = 1.0
            scale_y = 1.0

        self.program.setUniformValue(
            "u_transform_center",
            center_x,
            center_y,
        )

        self.program.setUniformValue(
            "u_transform_scale",
            scale_x,
            scale_y,
        )

        self.program.setUniformValue1f(
            "u_opacity",
            float(layer.opacity),
        )

        self.program.setUniformValue1i(
            "u_texture",
            0,
        )

        gpu_texture.texture.bind(
            0
        )

        gl = (
            gpu_texture
            .texture
            .context()
            .functions()
            if hasattr(
                gpu_texture.texture,
                "context",
            )
            else None
        )

        if gl is None:
            from PySide6.QtGui import QOpenGLContext

            context = (
                QOpenGLContext.currentContext()
            )

            if context is not None:
                gl = context.functions()

        if gl is not None:
            gl.glDrawArrays(
                0x0005,
                0,
                4,
            )

        gpu_texture.texture.release()

        self.vbo.release()
        self.vao.release()

        self.program.release()

    # ----------------------------------------------------------
    # NETTOYAGE
    # ----------------------------------------------------------

    def cleanup(self) -> None:

        for gpu_texture in list(
            self.textures.values()
        ):

            try:
                gpu_texture.texture.destroy()
            except RuntimeError:
                pass

        self.textures.clear()

        if self.vao is not None:

            try:
                self.vao.destroy()
            except RuntimeError:
                pass

            self.vao = None

        if self.vbo is not None:

            try:
                self.vbo.destroy()
            except RuntimeError:
                pass

            self.vbo = None

        if self.program is not None:

            try:
                self.program.removeAllShaders()
            except RuntimeError:
                pass

            self.program = None

        self.initialized = False
