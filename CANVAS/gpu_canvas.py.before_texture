from PySide6.QtCore import Qt, QPointF
from PySide6.QtGui import (
    QImage,
    QPainter,
    QTransform,
)
from PySide6.QtOpenGLWidgets import QOpenGLWidget


class GPUCanvas(QOpenGLWidget):
    """
    Canvas GPU préparatoire.

    Pour cette première étape :
    - conserve une QImage comme source ;
    - affiche la texture via OpenGL/Qt ;
    - supporte zoom et déplacement ;
    - reste totalement séparé du Canvas actuel.
    """

    def __init__(
        self,
        parent=None,
    ) -> None:

        super().__init__(
            parent
        )

        self.setFocusPolicy(
            Qt.FocusPolicy.StrongFocus
        )

        self.zoom: float = 1.0

        self.pan_x: float = 0.0
        self.pan_y: float = 0.0

        self.image: QImage | None = None

        self.last_mouse_position = QPointF()

        self.panning: bool = False

        self.setAttribute(
            Qt.WidgetAttribute.WA_OpaquePaintEvent,
            True
        )

    # =========================================================
    # IMAGE
    # =========================================================

    def set_image(
        self,
        image: QImage | None,
    ) -> None:

        if image is None:
            self.image = None
        else:
            self.image = image

        self.update()

    # =========================================================
    # ZOOM
    # =========================================================

    def set_zoom(
        self,
        zoom: float,
    ) -> None:

        self.zoom = max(
            0.01,
            min(
                100.0,
                float(zoom),
            ),
        )

        self.update()

    # =========================================================
    # RESET
    # =========================================================

    def reset_view(
        self,
    ) -> None:

        self.zoom = 1.0

        self.pan_x = 0.0
        self.pan_y = 0.0

        self.update()

    # =========================================================
    # PAINT
    # =========================================================

    def paintGL(
        self,
    ) -> None:

        painter = QPainter(
            self
        )

        painter.setRenderHint(
            QPainter.RenderHint.SmoothPixmapTransform,
            True,
        )

        painter.fillRect(
            self.rect(),
            Qt.GlobalColor.black,
        )

        if self.image is None:
            painter.end()
            return

        image_width = (
            self.image.width()
        )

        image_height = (
            self.image.height()
        )

        if image_width <= 0 or image_height <= 0:
            painter.end()
            return

        target_width = (
            image_width * self.zoom
        )

        target_height = (
            image_height * self.zoom
        )

        x = (
            (self.width() - target_width) * 0.5
            + self.pan_x
        )

        y = (
            (self.height() - target_height) * 0.5
            + self.pan_y
        )

        painter.drawImage(
            int(x),
            int(y),
            self.image.scaled(
                int(target_width),
                int(target_height),
                Qt.AspectRatioMode.IgnoreAspectRatio,
                Qt.TransformationMode.SmoothTransformation,
            ),
        )

        painter.end()

    # =========================================================
    # SOURIS
    # =========================================================

    def mousePressEvent(
        self,
        event,
    ) -> None:

        if (
            event.button()
            == Qt.MouseButton.MiddleButton
        ):

            self.panning = True

            self.last_mouse_position = (
                event.position()
            )

            event.accept()

            return

        super().mousePressEvent(
            event
        )

    def mouseMoveEvent(
        self,
        event,
    ) -> None:

        if self.panning:

            current = (
                event.position()
            )

            delta = (
                current
                - self.last_mouse_position
            )

            self.pan_x += delta.x()
            self.pan_y += delta.y()

            self.last_mouse_position = current

            self.update()

            event.accept()

            return

        super().mouseMoveEvent(
            event
        )

    def mouseReleaseEvent(
        self,
        event,
    ) -> None:

        if (
            event.button()
            == Qt.MouseButton.MiddleButton
        ):

            self.panning = False

            event.accept()

            return

        super().mouseReleaseEvent(
            event
        )

    # =========================================================
    # MOLETTE
    # =========================================================

    def wheelEvent(
        self,
        event,
    ) -> None:

        delta = event.angleDelta().y()

        if delta == 0:
            return

        if delta > 0:
            factor = 1.12
        else:
            factor = 1.0 / 1.12

        self.set_zoom(
            self.zoom * factor
        )

        event.accept()
