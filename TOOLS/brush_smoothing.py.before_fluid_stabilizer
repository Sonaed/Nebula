import math

from PySide6.QtCore import QPointF


class BrushSmoothing:
    """
    Stabilise et lisse les points d'un trait de pinceau.

    Le lissage est basé sur une moyenne pondérée des derniers points.
    Un niveau de 0.0 désactive pratiquement le lissage.
    Un niveau de 1.0 produit un lissage très important.
    """

    def __init__(
        self,
        strength: float = 0.0,
        buffer_size: int = 6
    ) -> None:

        self.strength = self.clamp(
            strength,
            0.0,
            1.0
        )

        self.buffer_size = max(
            2,
            int(buffer_size)
        )

        self.points: list[QPointF] = []

        self.last_output: QPointF | None = None

        self.in_stroke: bool = False

    # =========================================================
    # UTILITAIRES
    # =========================================================

    @staticmethod
    def clamp(
        value: float,
        minimum: float,
        maximum: float
    ) -> float:

        return max(
            minimum,
            min(
                maximum,
                value
            )
        )

    # =========================================================
    # CONFIGURATION
    # =========================================================

    def set_strength(
        self,
        strength: float
    ) -> None:

        self.strength = self.clamp(
            strength,
            0.0,
            1.0
        )

    def set_buffer_size(
        self,
        buffer_size: int
    ) -> None:

        self.buffer_size = max(
            2,
            int(buffer_size)
        )

        if len(self.points) > self.buffer_size:
            self.points = self.points[
                -self.buffer_size:
            ]

    # =========================================================
    # DÉBUT DE TRAIT
    # =========================================================

    def begin_stroke(
        self
    ) -> None:

        self.reset()

        self.in_stroke = True

    # =========================================================
    # FIN DE TRAIT
    # =========================================================

    def end_stroke(
        self
    ) -> None:

        self.in_stroke = False

        self.reset()

    # =========================================================
    # RESET
    # =========================================================

    def reset(self) -> None:

        self.points.clear()

        self.last_output = None

    # =========================================================
    # DISTANCE
    # =========================================================

    @staticmethod
    def distance(
        first: QPointF,
        second: QPointF
    ) -> float:

        return math.hypot(
            second.x() - first.x(),
            second.y() - first.y()
        )

    # =========================================================
    # AJOUT D'UN POINT
    # =========================================================

    def add_point(
        self,
        point: QPointF
    ) -> QPointF:

        current = QPointF(
            point
        )

        self.points.append(
            current
        )

        if len(self.points) > self.buffer_size:

            self.points.pop(
                0
            )

        # -----------------------------------------------------
        # Premier point
        # -----------------------------------------------------

        if len(self.points) == 1:

            self.last_output = QPointF(
                current
            )

            return QPointF(
                current
            )

        # -----------------------------------------------------
        # Pas de lissage
        # -----------------------------------------------------

        if self.strength <= 0.0:

            self.last_output = QPointF(
                current
            )

            return QPointF(
                current
            )

        # -----------------------------------------------------
        # Moyenne pondérée
        # -----------------------------------------------------

        total_weight = 0.0

        weighted_x = 0.0
        weighted_y = 0.0

        count = len(
            self.points
        )

        for index, buffered_point in enumerate(
            self.points
        ):

            age = (
                index + 1
            ) / count

            # Les points récents sont plus importants.
            weight = (
                age
                ** (2.0 + self.strength * 4.0)
            )

            weighted_x += (
                buffered_point.x()
                * weight
            )

            weighted_y += (
                buffered_point.y()
                * weight
            )

            total_weight += weight

        if total_weight <= 0.0:

            output = QPointF(
                current
            )

        else:

            target = QPointF(
                weighted_x / total_weight,
                weighted_y / total_weight
            )

            # -------------------------------------------------
            # Mélange entre position brute et position lissée
            # -------------------------------------------------

            blend = self.strength

            if self.last_output is None:

                output = QPointF(
                    target
                )

            else:

                output = QPointF(
                    self.last_output.x()
                    + (
                        target.x()
                        - self.last_output.x()
                    ) * blend,

                    self.last_output.y()
                    + (
                        target.y()
                        - self.last_output.y()
                    ) * blend
                )

        self.last_output = QPointF(
            output
        )

        return QPointF(
            output
        )

    # =========================================================
    # TRAITEMENT D'UNE LISTE DE POINTS
    # =========================================================

    def smooth_points(
        self,
        points: list[QPointF]
    ) -> list[QPointF]:

        self.reset()

        smoothed: list[QPointF] = []

        for point in points:

            smoothed.append(
                self.add_point(
                    point
                )
            )

        return smoothed
