from PySide6.QtGui import QImage


class BrushEngine:
    """
    Moteur central de la brosse.

    Les sous-systèmes seront branchés ici :
    - dynamiques
    - pointe
    - texture
    - couleur
    - peinture
    - stabilisation
    """

    def __init__(
        self,
        antialiasing: bool = True,
    ) -> None:

        self.antialiasing = antialiasing

        self.dynamics = None
        self.tip = None
        self.texture = None
        self.color = None
        self.paint = None

    def draw(
        self,
        image: QImage,
    ) -> None:
        """
        Point d'entrée du moteur de rendu.
        """
        if image.isNull():
            return
